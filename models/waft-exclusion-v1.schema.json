{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whitewater://schema/phase2.5/waft-exclusion-v1",
  "title": "White Water Phase 2.5 WAFT candidate exclusion v1",
  "description": "A provenance-only exclusion record for WAFT when exact weights are identified but applicable terms cannot be established.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "status",
    "candidate",
    "upstream",
    "checkpoint",
    "backbone",
    "verification",
    "license_surfaces",
    "exclusion",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "whitewater-p25-waft-exclusion-v1"},
    "status": {"const": "excluded"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "backbone": {"$ref": "#/$defs/backbone"},
    "verification": {"$ref": "#/$defs/verification"},
    "license_surfaces": {"$ref": "#/$defs/license_surfaces"},
    "exclusion": {"$ref": "#/$defs/exclusion"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "family"],
      "properties": {
        "id": {"const": "waft-twins"},
        "role": {"const": "shipping-candidate"},
        "family": {"type": "string", "minLength": 1}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "license_audit", "audit_date"],
      "properties": {
        "repository": {"const": "https://github.com/princeton-vl/WAFT.git"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "license_audit": {"type": "string", "minLength": 1},
        "audit_date": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "url", "size_bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checkpoint_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "compressed_size_bytes", "crc32", "method", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "compressed_size_bytes": {"type": "integer", "minimum": 0},
        "crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "method": {"enum": ["store", "deflate"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "identity_status",
        "observed_public_object",
        "selected_member",
        "archive_inventory",
        "identity_evidence",
        "license_evidence"
      ],
      "properties": {
        "repository": {"const": "https://drive.google.com/drive/folders/1joBWKGoH2RUdCgcge8Tz2osOHcQUX5m_"},
        "identity_status": {"enum": ["unresolved", "resolved"]},
        "observed_public_object": {"$ref": "#/$defs/checkpoint_object"},
        "selected_member": {"$ref": "#/$defs/checkpoint_member"},
        "archive_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkpoint_member"}
        },
        "identity_evidence": {"type": "string", "minLength": 1},
        "license_evidence": {"type": "string", "minLength": 1}
      }
    },
    "backbone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "identity_status",
        "source_file",
        "repository",
        "revision",
        "checkpoint_sha256",
        "reference_weight",
        "identity_evidence",
        "license_evidence"
      ],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "identity_status": {"enum": ["unresolved", "bundled_in_checkpoint"]},
        "source_file": {"type": "string", "minLength": 1},
        "repository": {"const": "https://huggingface.co/timm/twins_svt_large.in1k"},
        "revision": {"type": ["string", "null"]},
        "checkpoint_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reference_weight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision", "size_bytes", "sha256", "license", "license_evidence"],
          "properties": {
            "url": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "license": {"type": "string", "minLength": 1},
            "license_evidence": {"type": "string", "minLength": 1}
          }
        },
        "identity_evidence": {"type": "string", "minLength": 1},
        "license_evidence": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "torch",
        "torchvision",
        "timm",
        "pretrained_initialization",
        "state_dict_keys",
        "encoder_backbone_keys",
        "missing_keys",
        "unexpected_keys"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "torchvision": {"type": "string", "minLength": 1},
        "timm": {"type": "string", "minLength": 1},
        "pretrained_initialization": {"const": false},
        "state_dict_keys": {"type": "integer", "minimum": 1},
        "encoder_backbone_keys": {"type": "integer", "minimum": 1},
        "missing_keys": {"const": 0},
        "unexpected_keys": {"const": 0}
      }
    },
    "license_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "commercial_use_permitted",
        "redistribution_permitted",
        "audit",
        "evidence"
      ],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "commercial_use_permitted": {"enum": ["yes", "no", "unknown"]},
        "redistribution_permitted": {"enum": ["yes", "no", "unknown"]},
        "audit": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "license_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "checkpoint", "backbone"],
      "properties": {
        "code": {"$ref": "#/$defs/license_surface"},
        "checkpoint": {"$ref": "#/$defs/license_surface"},
        "backbone": {"$ref": "#/$defs/license_surface"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "decision", "next_evidence_required"],
      "properties": {
        "reason_code": {
          "enum": [
            "checkpoint_license_terms_unknown",
            "export_or_operator_failure"
          ]
        },
        "decision": {"const": "not_eligible_for_p25_bakeoff_or_shipping"},
        "next_evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
