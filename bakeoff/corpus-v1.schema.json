{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whitewater://schema/phase2.5/corpus-v1",
  "title": "White Water Phase 2.5 evaluation corpus v1",
  "description": "Anonymous metadata for synthetic, public and air-gapped production shots. It never embeds source frames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "corpus_id", "partitions"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "whitewater-p25-v1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "created_utc": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "maxLength": 2000},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/partition"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "shots"],
      "properties": {
        "id": {"enum": ["synthetic", "public", "production_external"]},
        "kind": {"enum": ["synthetic", "public", "production_external"]},
        "description": {"type": "string", "maxLength": 1000},
        "generator": {"type": "string", "minLength": 1},
        "terms": {"$ref": "#/$defs/terms"},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shot"}
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "usage", "training_overlap"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "usage": {"type": "string", "minLength": 1},
        "training_overlap": {"enum": ["unknown", "none_found", "possible", "confirmed"]},
        "record": {"type": "string", "minLength": 1}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path_pattern",
        "first_frame",
        "last_frame",
        "reference_frame",
        "width",
        "height",
        "pixel_aspect_ratio",
        "encoding",
        "channels",
        "bit_depth",
        "categories"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "case_id": {"$ref": "#/$defs/id"},
        "path_pattern": {"type": "string", "minLength": 1},
        "first_frame": {"type": "integer"},
        "last_frame": {"type": "integer"},
        "reference_frame": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "pixel_aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
        "encoding": {"enum": ["scene-linear", "log"]},
        "channels": {"enum": ["RGB", "RGBA"]},
        "bit_depth": {"enum": ["half", "float"]},
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "annotations": {"type": ["string", "null"]},
        "chain_length": {"enum": [1, 2, 4, 8]},
        "truth": {"$ref": "#/$defs/truth"},
        "generator_parameters": {"type": "object"},
        "frame_sha256": {
          "type": "array",
          "items": {"$ref": "#/$defs/frame_hash"},
          "uniqueItems": true
        }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["analytic", "landmarks", "none"]},
        "definition": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "coordinate_convention": {"type": "string", "minLength": 1}
      }
    },
    "frame_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "sha256"],
      "properties": {
        "frame": {"type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
